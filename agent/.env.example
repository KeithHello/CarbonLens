# CarbonLens Agent — Environment Variables
# Copy to .env and fill in your values

# --- Required ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# --- MongoDB MCP ---
# Local development supports either:
# 1) Streamable HTTP MCP URL:
#    MONGODB_MCP_URL=http://localhost:8080/mcp
# 2) MongoDB Atlas connection string:
#    MONGODB_MCP_URL=mongodb+srv://<user>:<password>@<cluster>/<database>
#
# Production Agent Runtime should use an HTTPS MCP server URL, because the
# managed Python runtime should not be assumed to have node/npx available.
MONGODB_MCP_URL=http://localhost:8080/mcp

# --- Agent Engine ---
AGENT_ENGINE_LOCATION=us-central1
AGENT_DISPLAY_NAME=carbonlens-agent
AGENT_MIN_INSTANCES=0
AGENT_MAX_INSTANCES=3
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true

# --- Model (optional, default: gemini-flash-latest) ---
GEMINI_MODEL=gemini-flash-latest

# --- Agent Platform Express Mode (optional) ---
# If you deploy with an Express Mode API key:
#   adk deploy agent_engine --api_key="$GOOGLE_API_KEY" agent
# or set GOOGLE_API_KEY here and pass --api_key explicitly.
# GOOGLE_API_KEY=
# GOOGLE_GENAI_USE_VERTEXAI=true
